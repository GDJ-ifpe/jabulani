[gd_scene format=3]

[ext_resource type="Script" path="res://fases/fase1_sertao/cutscenes/abertura.gd" id="1_palco"]
[ext_resource type="Script" path="res://shared/systems/cutscene_player.gd" id="2_cutscene"]
[ext_resource type="Script" path="res://shared/systems/dialogue_line.gd" id="3_fala"]
[ext_resource type="AudioStream" path="res://fases/fase1_sertao/assets/soundtracks/dungeon_ambient_1.ogg" id="4_ambiente"]

[sub_resource type="Resource" id="Resource_fala1"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "Antes tudo era verde… Os pássaros cantavam cânticos felizes, os serem das florestas dançavam alegres e os que nadam nas águas viviam suas vidas, imperturbados… Tudo fluía naturalmente, como o rio flui para o mar…"
acao = &"mostrar_regioes_verdes"

[sub_resource type="Resource" id="Resource_fala2"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "Até que um dia"
acao = &"escurecer"

[sub_resource type="Resource" id="Resource_fala3"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "E sempre tem um dia – uma mancha surgiu… De início era algo pequeno, inofensivo, surgido a partir do descuido dos homens. Mas a mancha cresceu e com ela veio a seca,"
acao = &"mostrar_seca"

[sub_resource type="Resource" id="Resource_fala4"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "o lixo,"
acao = &"mostrar_lixo"

[sub_resource type="Resource" id="Resource_fala5"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "a poluição"
acao = &"mostrar_poluicao"

[sub_resource type="Resource" id="Resource_fala6"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "Essa mancha ganhou nome: PoLuizão, O monstro de lixo. Ele trouxe consigo o nosso fim… Não conseguiremos aguentar por muito mais tempo."
acao = &"escurecer"

[sub_resource type="Resource" id="Resource_fala7"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "Aos poucos, os guardiões foram caindo… Todos, menos um."

[sub_resource type="Resource" id="Resource_fala8"]
script = ExtResource("3_fala")
falante = "Narrador"
texto = "O menor de todos ainda persevera… Jabulani, levante-se, você é o último dos guardiões, nossa última esperança…"

[sub_resource type="Resource" id="Resource_passo9"]
script = ExtResource("3_fala")
acao = &"acordar_jabulani"
duracao_sem_texto = 3.6

[node name="Abertura" type="Node2D"]
script = ExtResource("1_palco")

[node name="CutscenePlayer" type="Node" parent="."]
script = ExtResource("2_cutscene")
id = &"abertura"
falas = Array[ExtResource("3_fala")]([SubResource("Resource_fala1"), SubResource("Resource_fala2"), SubResource("Resource_fala3"), SubResource("Resource_fala4"), SubResource("Resource_fala5"), SubResource("Resource_fala6"), SubResource("Resource_fala7"), SubResource("Resource_fala8"), SubResource("Resource_passo9")])
proxima_cena = "res://fases/fase1_sertao/subfase1_caverna/caverna.tscn"
ambiente = ExtResource("4_ambiente")
